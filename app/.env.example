# ============================================================
#  PAGODA — Configuración
#  Copia este archivo como .env y ajusta los valores.
# ============================================================

# Puerto del servidor
PORT=3000

# Clave para firmar las sesiones.
# ⚠️ OBLIGATORIO cambiarla en producción por una cadena larga y aleatoria.
#    Puedes generar una con:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria

# Marca 'production' cuando el sitio corra bajo HTTPS
# (activa la cookie segura).
NODE_ENV=development

# Credenciales del primer administrador (solo las usa `npm run seed`)
ADMIN_USER=crys
ADMIN_PASS=cambia-esta-contrasena
